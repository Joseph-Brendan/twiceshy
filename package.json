{
  "name": "twiceshy-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Twiceshy: Repeat-Action Guard for AI agents",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:stress": "vitest run stress --passWithNoTests",
    "build": "pnpm -r --filter='./packages/*' run build",
    "check:package": "pnpm -r --filter='./packages/*' run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.25",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.6.1"
}
