{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "store": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sqlite"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "memory"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "window": {
      "type": [
        "number",
        "string"
      ]
    },
    "retention": {
      "type": [
        "number",
        "string"
      ]
    },
    "onStoreFailure": {
      "type": "string",
      "enum": [
        "closed",
        "open"
      ]
    },
    "toolNaming": {
      "type": "string",
      "enum": [
        "prefix",
        "none"
      ]
    },
    "trustIdempotentHint": {
      "type": "boolean"
    },
    "annotateDuplicates": {
      "type": "boolean"
    },
    "exposeRecentActions": {
      "type": "boolean"
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "tools": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "guard": {
                      "type": "boolean"
                    },
                    "keyFields": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "ignoreFields": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "normalize": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "number",
                          "trim",
                          "lowercase",
                          "lowercase-trim"
                        ]
                      }
                    },
                    "timeoutMs": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "treatToolErrorsAsDefinite": {
                      "type": "boolean"
                    },
                    "storeResult": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "tools": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "guard": {
                      "type": "boolean"
                    },
                    "keyFields": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "ignoreFields": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "normalize": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "number",
                          "trim",
                          "lowercase",
                          "lowercase-trim"
                        ]
                      }
                    },
                    "timeoutMs": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "treatToolErrorsAsDefinite": {
                      "type": "boolean"
                    },
                    "storeResult": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "mcpServers"
  ],
  "additionalProperties": false
}
