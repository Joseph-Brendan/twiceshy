{
  "name": "@twiceshy/mcp-proxy",
  "version": "0.0.0",
  "description": "MCP proxy with repeat-action guard",
  "author": "Joseph Brendan",
  "license": "MIT",
  "type": "module",
  "bin": {
    "twiceshy": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "^13.0.3",
    "twiceshy": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
