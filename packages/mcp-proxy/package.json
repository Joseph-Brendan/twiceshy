{
  "name": "@twiceshy/mcp-proxy",
  "version": "0.0.0",
  "description": "MCP proxy with repeat-action guard",
  "keywords": [
    "mcp",
    "ai-agents",
    "idempotency",
    "retries",
    "duplicate-prevention"
  ],
  "author": "Joseph Brendan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph-Brendan/twiceshy.git",
    "directory": "packages/mcp-proxy"
  },
  "type": "module",
  "bin": {
    "twiceshy": "./dist/cli.js",
    "mcp-proxy": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "schema:generate": "pnpm build && node ./scripts/generate-schema.mjs",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "~2.3.1",
    "@modelcontextprotocol/server": "~2.3.1",
    "better-sqlite3": "^13.0.3",
    "twiceshy": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
