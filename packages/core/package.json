{
  "name": "twiceshy",
  "version": "0.1.0",
  "description": "Zero-setup repeat-action guard for AI agents",
  "keywords": [
    "mcp",
    "ai-agents",
    "idempotency",
    "retries",
    "duplicate-prevention"
  ],
  "author": "Joseph Brendan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph-Brendan/twiceshy.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stores/contract": {
      "types": "./dist/stores/contract.d.ts",
      "import": "./dist/stores/contract.js"
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "typesVersions": {
    "*": {
      "stores/contract": [
        "./dist/stores/contract.d.ts"
      ],
      "sqlite": [
        "./dist/sqlite.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --exclude-entrypoints ./stores/contract && attw --pack . --entrypoints ./stores/contract --profile esm-only"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "better-sqlite3": "^13.0.3",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
