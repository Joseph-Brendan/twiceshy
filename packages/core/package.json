{
  "name": "twiceshy",
  "version": "0.0.0",
  "description": "Zero-setup repeat-action guard for AI agents",
  "author": "Joseph Brendan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "better-sqlite3": "^13.0.3",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
